# Frontend e portas locais
API_PORT=8000
WEB_PORT=5174
VITE_API_URL=/api/v1
VITE_ENABLE_MOCKS=false
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA

# API e Supabase
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA
SUPABASE_SECRET_KEY=sb_secret_SUBSTITUA
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false

# Segredos: substitua em staging/producao
PASSWORD_PEPPER=gere-outro-segredo-aleatorio-longo
FIELD_ENCRYPTION_KEY=gere-com-python-fernet

# CORS
CORS_ORIGINS=http://localhost:5174,http://localhost:8080
CORS_ORIGIN_REGEX=

# Administrador inicial (usado apenas por npm run bootstrap-admin)
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=admin@curitibaempreiteira.com
INITIAL_ADMIN_PASSWORD=defina-uma-senha-forte

# Arquivos persistentes na Vercel
BLOB_READ_WRITE_TOKEN=

# Reconhecimento facial
FACE_EAGER_INITIALIZE=true
FACE_PROVIDER=insightface
FACE_MODEL_NAME=buffalo_l
FACE_MODEL_ROOT=~/.insightface
FACE_EXECUTION_PROVIDERS=CPUExecutionProvider
FACE_EXPECTED_EMBEDDING_DIMENSION=512
FACE_THRESHOLD_PROFILE=development-uncalibrated
FACE_THRESHOLDS_CALIBRATED=false
FACE_DETECTION_SIZES=320,640,1280
FACE_MIN_DETECTION_CONFIDENCE=0.32
FACE_SECONDARY_FACE_SCORE_GAP=0.25
FACE_SECONDARY_FACE_CONFIDENCE=0.50
FACE_MIN_SIMILARITY=0.62
FACE_STRONG_SIMILARITY=0.78
FACE_MATCH_MARGIN=0.06
FACE_ENROLLMENT_MIN_IMAGES=5
FACE_ENROLLMENT_MIN_QUALITY=0.48
FACE_ENROLLMENT_MIN_FACE_AREA_RATIO=0.012
FACE_ENROLLMENT_TURN_MIN_YAW=12
FACE_ENROLLMENT_TURN_MAX_YAW=42
FACE_ENROLLMENT_LOOK_UP_MIN_PITCH=8
FACE_ENROLLMENT_LOOK_UP_MAX_PITCH=32
FACE_MIN_LIVENESS=0.70
FACE_MIN_QUALITY=0.50
FACE_MIN_FACE_AREA_RATIO=0.015
FACE_MIN_BLUR_VARIANCE=34
FACE_MIN_LUMINANCE=32
FACE_MAX_LUMINANCE=225
FACE_MIN_CONTRAST=17
