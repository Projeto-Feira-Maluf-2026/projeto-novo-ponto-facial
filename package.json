{
  "name": "curitiba-empreiteira-ponto-facial",
  "version": "1.0.0",
  "description": "Sistema corporativo de controle de ponto facial da Curitiba Empreiteira",
  "scripts": {
    "build": "npm run build:vercel --workspace=web",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "start": "powershell -ExecutionPolicy Bypass -File scripts/start.ps1",
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/start.ps1",
    "stop": "powershell -ExecutionPolicy Bypass -File scripts/stop.ps1",
    "bootstrap-admin": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap-admin.ps1",
    "seed": "powershell -ExecutionPolicy Bypass -File scripts/seed-demo.ps1",
    "api:dev": "cd api && uvicorn app.main:application --reload --host 0.0.0.0 --port 8000",
    "web:dev": "cd web && npm run dev",
    "web:build": "cd web && npm run build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "install:web": "cd web && npm install",
    "mobile:get": "cd mobile && flutter pub get"
  },
  "workspaces": ["web"],
  "engines": {
    "node": "22.x"
  }
}
