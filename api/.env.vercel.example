# Obrigatorias
ENVIRONMENT=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET_KEY=gere-um-segredo-aleatorio-longo
PASSWORD_PEPPER=gere-outro-segredo-aleatorio-longo
FIELD_ENCRYPTION_KEY=gere-com-python-fernet
CORS_ORIGINS=https://SEU-FRONTEND.vercel.app
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Bootstrap unico do primeiro administrador
BOOTSTRAP_ADMIN_TOKEN=gere-um-token-aleatorio-longo
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=admin@seudominio.com
INITIAL_ADMIN_PASSWORD=troque-por-uma-senha-forte

# Serverless
AUTO_CREATE_TABLES=false
FACE_EAGER_INITIALIZE=false
FACE_PROVIDER=insightface
FACE_MODEL_ROOT=/tmp/.insightface
FACE_MAX_IMAGE_BYTES=3000000
REDIS_REQUIRED=false

# Adicionada automaticamente ao conectar um Vercel Blob privado
BLOB_READ_WRITE_TOKEN=
