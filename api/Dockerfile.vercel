FROM python:3.15-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928 AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential curl unzip \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock ./
RUN pip install --no-cache-dir uv==0.10.11 \
    && uv sync --locked --no-dev --extra ai --no-install-project

RUN mkdir -p /opt/insightface/models/buffalo_l \
    && curl --fail --location --retry 4 --retry-all-errors \
        https://github.com/deepinsight/insightface/releases/download/v0.7/buffalo_l.zip \
        --output /tmp/buffalo_l.zip \
    && unzip -q /tmp/buffalo_l.zip det_10g.onnx w600k_r50.onnx \
        -d /opt/insightface/models/buffalo_l \
    && test -s /opt/insightface/models/buffalo_l/det_10g.onnx \
    && test -s /opt/insightface/models/buffalo_l/w600k_r50.onnx \
    && rm -f /tmp/buffalo_l.zip

# Antifraude (foto ou video mostrado a camera): MiniFASNet V2 e V1SE em ONNX.
RUN mkdir -p /opt/insightface/models/minifasnet \
    && cd /opt/insightface/models/minifasnet \
    && for model in MiniFASNetV2 MiniFASNetV1SE; do \
        curl --fail --location --retry 4 --retry-all-errors \
            "https://github.com/yakhyo/face-anti-spoofing/releases/download/weights/${model}.onnx" \
            --output "${model}.onnx" || exit 1; \
    done \
    && printf '%s  %s\n' \
        b32929adc2d9c34b9486f8c4c7bc97c1b69bc0ea9befefc380e4faae4e463907 MiniFASNetV2.onnx \
        ebab7f90c7833fbccd46d3a555410e78d969db5438e169b6524be444862b3676 MiniFASNetV1SE.onnx \
        | sha256sum -c -

FROM python:3.15-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928 AS runtime

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp \
    PORT=8000 \
    FACE_RUNTIME_MODE=full \
    FACE_PROVIDER=insightface \
    FACE_MODEL_NAME=buffalo_l \
    FACE_MODEL_ROOT=/opt/insightface \
    FACE_MODEL_SHA256=4c06341c33c2ca1f86781dab0e829f88ad5b64be9fba56e56bc9ebdefc619e43 \
    FACE_EXECUTION_PROVIDERS=CPUExecutionProvider \
    FACE_DETECTION_SIZES=320,640,1280 \
    FACE_EAGER_INITIALIZE=false \
    FACE_PAD_AUTO_DOWNLOAD=false

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --no-create-home app \
    && mkdir -p /app/uploads && chown app:app /app/uploads

COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /opt/insightface /opt/insightface
COPY app ./app
COPY container_entrypoint.py ./container_entrypoint.py

USER 10001:10001
EXPOSE 8000
CMD ["/app/.venv/bin/python", "/app/container_entrypoint.py"]
