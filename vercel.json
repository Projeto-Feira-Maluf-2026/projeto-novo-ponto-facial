{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "fluid": true,
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{.git/**,.github/**,.pytest_cache/**,.ruff_cache/**,**/__pycache__/**,**/.venv/**,node_modules/**,dist/**,web/**,mobile/**,docs/**,api/tests/**,models/**,logs/**,scripts/**,supabase/**,.env*}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
